{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:modernization-harness:claim:0.1.0",
  "title": "独立調査の主張",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "system_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "agent_id": {
      "enum": [
        "a",
        "b",
        "c"
      ]
    },
    "subject_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "enum": [
        "confirmed",
        "inferred",
        "unknown"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "system_id",
    "snapshot_id",
    "run_id",
    "agent_id",
    "subject_id",
    "statement",
    "confidence",
    "evidence_ids",
    "notes"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "confidence": {
            "const": "confirmed"
          }
        }
      },
      "then": {
        "properties": {
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      }
    }
  ]
}
