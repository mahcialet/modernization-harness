{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:modernization-harness:system:0.1.0",
  "title": "システム構成",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "readiness": {
      "enum": [
        "draft",
        "ready"
      ]
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "url": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "url"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "applications": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "source_units": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "repository_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "enum": [
                    "main",
                    "build",
                    "generated"
                  ]
                }
              },
              "required": [
                "repository_id",
                "path",
                "role"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "source_units"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "source_units": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "repository_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "enum": [
                    "main",
                    "build",
                    "generated"
                  ]
                }
              },
              "required": [
                "repository_id",
                "path",
                "role"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "source_units"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "name",
          "kind"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "id",
    "name",
    "readiness",
    "repositories",
    "applications",
    "components",
    "resources"
  ],
  "additionalProperties": false
}
