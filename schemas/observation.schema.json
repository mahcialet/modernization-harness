{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:modernization-harness:observation:0.1.0",
  "title": "比較観測",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "system_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "side": {
      "enum": [
        "legacy",
        "modern",
        "mixed"
      ]
    },
    "raw_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "normalized_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "initial_state_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "completed": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "id",
    "system_id",
    "snapshot_id",
    "scenario_id",
    "side",
    "raw_digest",
    "normalized_digest",
    "evidence_ids",
    "initial_state_digest",
    "completed"
  ],
  "additionalProperties": false
}
