{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:modernization-harness:inventory:0.1.0",
  "title": "統合インベントリ",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "system_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "status": {
      "enum": [
        "draft",
        "partial",
        "approved",
        "superseded"
      ]
    },
    "finding_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "area": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "confirmed",
              "investigated-no-evidence",
              "not-inspected",
              "blocked"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "area",
          "status",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "approval_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "system_id",
    "snapshot_id",
    "status",
    "finding_ids",
    "coverage",
    "unknowns",
    "approval_id"
  ],
  "additionalProperties": false
}
