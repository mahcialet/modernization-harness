{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:modernization-harness:snapshot:0.1.0",
  "title": "システムスナップショット",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "system_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "repository_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "commit": {
            "type": "string",
            "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
          }
        },
        "required": [
          "repository_id",
          "commit"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entity_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_commit": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "entity_id",
          "kind",
          "digest",
          "source_commit"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "configuration_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "initial_state_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "environment_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "system_id",
    "created_at",
    "repositories",
    "artifacts",
    "configuration_digest",
    "initial_state_digest",
    "environment_id"
  ],
  "additionalProperties": false
}
