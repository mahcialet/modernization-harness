{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:modernization-harness:repository-lock:0.1.0",
  "title": "ソースの固定構成",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "system_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "readiness": {
      "enum": [
        "draft",
        "ready"
      ]
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "repository_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "commit": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "repository_id",
          "ref",
          "commit"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "system_id",
    "readiness",
    "repositories"
  ],
  "additionalProperties": false
}
