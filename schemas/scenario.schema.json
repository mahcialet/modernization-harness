{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:modernization-harness:scenario:0.1.0",
  "title": "業務比較シナリオ",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "system_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "approved",
        "retired"
      ]
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "effects": {
      "type": "array",
      "items": {
        "enum": [
          "read",
          "db-write",
          "external-send",
          "file-write",
          "queue-write",
          "reset",
          "fault-injection"
        ]
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "initial_state": {
      "type": "object",
      "minProperties": 1
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          }
        },
        "additionalProperties": true
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "completion": {
      "type": "object",
      "properties": {
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "condition",
        "timeout_seconds"
      ],
      "additionalProperties": false
    },
    "normalization_rules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "contract_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "id",
    "system_id",
    "title",
    "status",
    "required_capabilities",
    "effects",
    "initial_state",
    "steps",
    "observations",
    "completion",
    "normalization_rules",
    "contract_refs"
  ],
  "additionalProperties": false
}
