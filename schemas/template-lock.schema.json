{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:modernization-harness:template-lock:0.1.0",
  "title": "テンプレート適用記録",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "template_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "template_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "template_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_release_tag": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "source_commit": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_kind": {
      "const": "local-bundle"
    },
    "values": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "base_dir": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "ownership": {
            "enum": [
              "managed",
              "seed"
            ]
          },
          "base_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "ownership",
          "base_sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "template_id",
    "template_version",
    "template_digest",
    "source_release_tag",
    "source_commit",
    "source_kind",
    "values",
    "base_dir",
    "files"
  ],
  "additionalProperties": false
}
