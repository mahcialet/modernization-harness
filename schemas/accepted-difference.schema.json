{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:modernization-harness:accepted-difference:0.1.0",
  "title": "承認する意図差",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "system_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "status": {
      "enum": [
        "proposed",
        "approved",
        "expired"
      ]
    },
    "match": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "legacy_value": {},
        "modern_value": {}
      },
      "required": [
        "path",
        "legacy_value",
        "modern_value"
      ],
      "additionalProperties": false
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "decision_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "approval_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "review_by": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "schema_version",
    "id",
    "system_id",
    "scenario_id",
    "status",
    "match",
    "rationale",
    "decision_id",
    "approval_id",
    "review_by"
  ],
  "additionalProperties": false
}
