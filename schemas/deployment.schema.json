{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:modernization-harness:deployment:0.1.0",
  "title": "実配備の観測",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "system_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "environment_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "instances": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "instance_id": {
            "type": "string",
            "minLength": 1
          },
          "account_id": {
            "type": "string",
            "minLength": 1
          },
          "region": {
            "type": "string",
            "minLength": 1
          },
          "ami_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "entity_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "embedded_components": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "component_id": {
                        "type": "string",
                        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
                      },
                      "digest": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      }
                    },
                    "required": [
                      "component_id",
                      "digest"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 0,
                  "uniqueItems": true
                }
              },
              "required": [
                "entity_id",
                "digest",
                "embedded_components"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "instance_id",
          "account_id",
          "region",
          "ami_id",
          "artifacts"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "id",
    "system_id",
    "environment_id",
    "observed_at",
    "instances",
    "evidence_ids"
  ],
  "additionalProperties": false
}
