{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:modernization-harness:run:0.1.0",
  "title": "調査実行",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "system_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "state": {
      "enum": [
        "created",
        "investigating",
        "reconciling",
        "awaiting_approval",
        "approved",
        "needs_followup",
        "failed",
        "cancelled",
        "partial"
      ]
    },
    "prompt_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "agent_backend": {
      "type": "string",
      "minLength": 1
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "agent_id": {
            "enum": [
              "a",
              "b",
              "c",
              "d"
            ]
          },
          "state": {
            "enum": [
              "pending",
              "running",
              "succeeded",
              "failed",
              "cancelled"
            ]
          },
          "output_digest": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "agent_id",
          "state",
          "output_digest"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "id",
    "system_id",
    "snapshot_id",
    "state",
    "prompt_digest",
    "agent_backend",
    "attempts"
  ],
  "additionalProperties": false
}
